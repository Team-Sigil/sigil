# Shared with the gateway (same values as its CRYPTO_HMAC_SECRET, AUSD_MINT, AGENT_WALLET_PUBKEY)
SIGNER_HMAC_SECRET=
AUSD_MINT=
AGENT_WALLET_PUBKEY=

# Crypto layer only. Create with: uv run python -m scripts.new_agent_wallet
AGENT_WALLET_KEY_ENC=
SIGNER_MASTER_KEY=

# Devnet only: the signer refuses any other cluster (SEC-14)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Read-only view registered_destinations; password = gateway's SIGIL_SIGNER_RO_PASSWORD
DATABASE_URL_READONLY=postgresql://sigil_signer_ro:...@localhost:5432/sigil

# The signer's own caps, in base units (1 aUSD = 1000000). Day = UTC day.
SIGNER_MAX_PER_TRANSFER_UNITS=200000000
SIGNER_MAX_PER_DAY_UNITS=300000000
# SIGNER_MAX_PER_SOURCE_PER_DAY_UNITS=                # optional cap per guardian reservoir

# true: skip the delegation check and the chain on /v1/transfer (signatures mock_<uuid>)
MOCK_CHAIN=false

# Durable idempotency ledger (keep it on a volume)
SIGNER_DB_PATH=data/signer.sqlite3
SIGNER_HOST=127.0.0.1
SIGNER_PORT=8300
