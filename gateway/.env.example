# postgres (docker-compose only)
SIGIL_OWNER_PASSWORD=
SIGIL_APP_PASSWORD=
SIGIL_SIGNER_RO_PASSWORD=

# database
DATABASE_URL=postgresql+psycopg://sigil_app:...@localhost:5432/sigil
DATABASE_URL_MIGRATIONS=postgresql+psycopg://sigil_owner:...@localhost:5432/sigil
TEST_DATABASE_URL=postgresql+psycopg://sigil_app:...@localhost:5432/sigil_test
TEST_DATABASE_URL_MIGRATIONS=postgresql+psycopg://sigil_owner:...@localhost:5432/sigil_test

# app layer sessions
JWT_SECRET=
JWT_TTL_HOURS=12
SIWS_DOMAIN=localhost:3000
DATA_ENCRYPTION_KEY=          # Fernet key, for chats and proofs at rest

# agent layer
AGENT_URL=http://agent:8100
AGENT_INBOUND_TOKEN=          # we send this to the agent service
PLATFORM_MAKER_TOKEN=         # the agent's maker sends this to us
PLATFORM_AUDITOR_TOKEN=       # the agent's Auditor sends this to us; must differ from the maker's

# crypto layer
CRYPTO_URL=http://crypto:8300
CRYPTO_HMAC_SECRET=
AUSD_MINT=
AGENT_WALLET_PUBKEY=

# verified in-app capture on iOS (off until APPLE_APP_ID is set)
APPLE_APP_ID=                         # "<Team ID>.<bundle id>"
APPLE_APP_ATTEST_PRODUCTION=true      # false for development App Attest keys
CAMERA_ONLY_PROOFS=false              # must match the agent layer's AGENT_CAMERA_ONLY_PROOFS

# limits
RATE_LIMIT_PER_MIN=30
LLM_TOKEN_BUDGET_PER_FAMILY_PER_DAY=200000

# docker-compose only: where the gateway container finds the other layers
# GATEWAY_AGENT_URL=http://host.docker.internal:8100
# GATEWAY_CRYPTO_URL=http://mock-crypto:8300
