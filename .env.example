# One file for the whole stack. `./sigil init` copies this to .env and fills every
# generated value. Shared values are set once here; docker-compose.yml maps them to the
# name each layer expects (e.g. CRYPTO_HMAC_SECRET -> the signer's SIGNER_HMAC_SECRET).

# ---- you set these -------------------------------------------------------------------
# The agents' model: openrouter (OPENROUTER_API_KEY) or anthropic (ANTHROPIC_API_KEY).
# AGENT_MAKER_PROVIDER / AGENT_AUDITOR_PROVIDER override it for one agent.
AGENT_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Empty = the provider's default (OpenRouter: Nemotron 3 Super, which is text-only and
# can't read receipt photos or PDFs). That still works: proofs a model can't read are
# never shown to it and never count, so anything needing proof goes to the guardian.
# For receipts, set a multimodal model and turn on what it reads.
AGENT_MAKER_MODEL=
AGENT_AUDITOR_MODEL=
AGENT_OPENROUTER_VISION=0
AGENT_OPENROUTER_DOCUMENTS=0
# Host of the app_url the iOS app gives Phantom (docs/auth-guide.md in the gateway).
SIWS_DOMAIN=sigil.app

# ---- generated by ./sigil init ---------------------------------------------------------
# Postgres role passwords (owner: migrations; app: gateway; signer_ro: signer).
SIGIL_OWNER_PASSWORD=
SIGIL_APP_PASSWORD=
SIGIL_SIGNER_RO_PASSWORD=
# Gateway sessions and data at rest (Fernet key).
JWT_SECRET=
DATA_ENCRYPTION_KEY=
# Gateway <-> agent: we send AGENT_INBOUND_TOKEN to the agent; it sends the maker or
# auditor token to us. The two platform tokens must differ.
AGENT_INBOUND_TOKEN=
PLATFORM_MAKER_TOKEN=
PLATFORM_AUDITOR_TOKEN=
# Gateway <-> signer HMAC secret.
CRYPTO_HMAC_SECRET=
# The agent wallet (from sigil-crypto's scripts.new_agent_wallet). Only the signer gets
# the encrypted key and the master key; the gateway gets the pubkey.
AGENT_WALLET_PUBKEY=
AGENT_WALLET_KEY_ENC=
SIGNER_MASTER_KEY=

# ---- filled by ./sigil devnet ----------------------------------------------------------
# The aUSD mint on devnet. With MOCK_CHAIN=true any valid pubkey works.
AUSD_MINT=

# ---- optional (defaults shown) --------------------------------------------------------
# GATEWAY_BIND=127.0.0.1                 # 0.0.0.0 to reach the gateway from a phone
# POSTGRES_PORT=5432                     # host port for Postgres (127.0.0.1 only)
# JWT_TTL_HOURS=12                       # max 12
# APPLE_APP_ID=                          # "<Team ID>.<bundle id>"; iOS capture off until set
# APPLE_APP_ATTEST_PRODUCTION=true
# CAMERA_ONLY_PROOFS=false               # applied to both gateway and agent
# RATE_LIMIT_PER_MIN=30
# DEPENDENT_MESSAGES_PER_DAY=50
# LLM_TOKEN_BUDGET_PER_GUARDIAN_PER_DAY=200000
# AGENT_SCHEDULER=1
# AGENT_MAKER_PROVIDER=                  # default: AGENT_LLM_PROVIDER
# AGENT_AUDITOR_PROVIDER=
# AGENT_MAKER_EFFORT=high                # low…max
# AGENT_AUDITOR_EFFORT=high
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PDF_ALLOWED_SIGNERS=LAZADA EXPRESS COMPANY LIMITED   # exact; roots go in config/pdf-trusted-roots.pem
# SOLANA_RPC_URL=https://api.devnet.solana.com   # devnet only; the signer refuses others
# SIGNER_MAX_PER_TRANSFER_UNITS=200000000        # base units, 1 aUSD = 1000000
# SIGNER_MAX_PER_DAY_UNITS=300000000
# MOCK_CHAIN=false                       # true: transfers skip the chain (mock_<uuid>)
